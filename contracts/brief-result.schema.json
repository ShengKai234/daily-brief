{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief-result.schema.json",
  "title": "BriefResult",
  "description": "Output of an AgentRunner for one BriefRequest. The worker validates it before posting to /internal/jobs/{job_id}/result; the API validates it again.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_date",
    "locale",
    "sections",
    "usage"
  ],
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "$defs": {
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "title",
        "status",
        "items"
      ],
      "properties": {
        "topic_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "insufficient_news"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "description": "Used when status is insufficient_news or when sources disagree (for example on a number)."
        },
        "items": {
          "type": "array",
          "maxItems": 10,
          "description": "Ordered by importance. Each item's rank equals its 1-based position (enforced by prefixItems).",
          "items": false,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 1
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 2
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 3
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 4
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 5
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 6
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 7
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 8
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 9
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Item"
                },
                {
                  "properties": {
                    "rank": {
                      "const": 10
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1
          }
        }
      },
      "$comment": "status ok requires at least one item; insufficient_news may have zero items (never pad)."
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "title",
        "summary",
        "source_name",
        "source_url",
        "published_at"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Equals the item's 1-based position in the section's items array."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "1-3 sentences in the agent's own words."
        },
        "source_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s/?#@]+([/?#][^\\s]*)?$",
          "description": "Absolute http(s) URL with a non-empty host, actually found by the agent.",
          "maxLength": 2048
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "model",
        "duration_ms",
        "search_count",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "claude_subscription",
            "anthropic_api",
            "stub"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "search_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
