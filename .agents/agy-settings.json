{
  "permissions": {
    "allow": [
      "command(npm)",
      "command(npx)",
      "command(node)",
      "command(make)",
      "command(docker compose)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git add)",
      "command(git commit)",
      "read_url(registry.npmjs.org)",
      "read_url(antigravity.google)",
      "read_url(docs.aws.amazon.com)",
      "read_url(aws.amazon.com)",
      "read_url(supabase.com)",
      "read_url(docs.github.com)",
      "read_url(code.claude.com)",
      "read_url(docs.anthropic.com)",
      "read_url(docs.claude.com)",
      "command(docker)",
      "command(gh pr create)",
      "command(gh pr view)",
      "command(regex:^cd [^;&|$`<>()]+( && (npm|npx|node|make|docker|uv)( [^;&|$`<>()]*)?)*$)",
      "command(git fetch)",
      "command(git merge)",
      "command(git push)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(git switch)",
      "command(regex:^git -C [^;&|$`<>()]+ (status|diff|log|show|add|commit|fetch|merge|push)( [^;&|$`<>()]*)?$)"
    ],
    "ask": [],
    "deny": [
      "command(regex:.*git( .*)? (reset|clean|filter-branch|filter-repo|rebase)( .*)?)",
      "command(regex:.*git .*push.*agent/(db|api|worker|infra).*)",
      "command(regex:.*git .*push.*(--force|--force-with-lease|--delete| -f| -d| :|main|memory).*)",
      "command(regex:.*git branch (-D|-d|--delete).*)",
      "command(gh pr merge)",
      "command(gh repo)",
      "command(gh api)",
      "command(gh secret)",
      "command(gh workflow)",
      "command(gh auth)",
      "command(git worktree remove)",
      "command(terraform)",
      "command(aws)",
      "command(supabase)",
      "command(sudo)",
      "command(rm -rf)",
      "write_file(.env)",
      "write_file(contracts/)",
      "write_file(api/)",
      "write_file(db/)",
      "write_file(worker/)",
      "write_file(infra/)"
    ]
  }
}
