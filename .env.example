# Copy to .env and fill in local values. .env is git-ignored.
# Placeholders only. Never commit real values.

# --- Compose / ports (per worktree, see AGENTS.md "Local stack") ---
COMPOSE_PROJECT_NAME=brief-main
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173

# --- App ---
# local | production
APP_ENV=local
LOG_LEVEL=info

# --- Database (local compose db) ---
POSTGRES_USER=brief
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=brief
DATABASE_URL=postgresql+asyncpg://brief:change-me-local-only@db:5432/brief

# --- Interface implementations (DESIGN 4.5) ---
# dev | supabase  (dev only allowed when APP_ENV=local)
AUTH_VERIFIER=dev
# postgres | sqs
JOB_QUEUE=postgres
# local | github
WORKER_DISPATCHER=local
# stub | claude_subscription | anthropic_api
AGENT_RUNNER=stub

# --- Dev auth (APP_ENV=local only) ---
DEV_JWT_SECRET=change-me-local-only

# --- Owner (DESIGN 2.1 row 8, 3.1). Real value only in your local .env ---
OWNER_EMAIL=owner@example.com

# --- Worker <-> API internal token ---
INTERNAL_SERVICE_TOKEN=change-me-local-only
API_BASE_URL=http://api:8000

# --- Scheduler (replaces EventBridge locally) ---
SCHEDULER_INTERVAL_SECONDS=900

# --- Shared agent memory (absolute path to ../daily-brief-memory/docs/agent-memory) ---
BRIEF_MEMORY_DIR=

# --- Production only (M2+). Leave empty locally ---
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_ANON_KEY=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=ShengKai234/daily-brief
