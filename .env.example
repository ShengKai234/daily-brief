# Copy to .env and fill in local values. .env is git-ignored.
# Placeholders only. Never commit real values.

# --- Compose / ports (per worktree, see AGENTS.md "Local stack") ---
COMPOSE_PROJECT_NAME=brief-main
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173

# --- App ---
# Required: local | production (no default after the auth cutover, DESIGN 3.4)
APP_ENV=local
LOG_LEVEL=info

# --- Database (local compose db) ---
POSTGRES_USER=brief
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=brief
# Three roles (DESIGN 3.4, docs/auth-passkey-design.md 4.4). Use a different random password for each.
# POSTGRES_USER above is only the local container superuser; `make migrate` uses it once to create
# these roles from the URLs below (APP_ENV=local) and nothing else connects with it.
#   DATABASE_URL           -> brief_runtime  (API, scheduler, local dev-session)
#   MIGRATION_DATABASE_URL -> brief_migrator (migrate service; owns the tables)
#   ADMIN_DATABASE_URL     -> brief_admin    (auth_admin CLI; in production only in Kai's password manager)
DATABASE_URL=postgresql+asyncpg://brief_runtime:change-me-runtime@db:5432/brief
MIGRATION_DATABASE_URL=postgresql+asyncpg://brief_migrator:change-me-migrator@db:5432/brief
ADMIN_DATABASE_URL=postgresql+asyncpg://brief_admin:change-me-admin@db:5432/brief

# --- Interface implementations (DESIGN 4.5) ---
# postgres | sqs
JOB_QUEUE=postgres
# local | github
WORKER_DISPATCHER=local
# stub | claude_subscription | anthropic_api
AGENT_RUNNER=stub

# --- Passkey auth (DESIGN 3.4, docs/auth-passkey-design.md) ---
# Exact hostname and origins; never derived from request headers. Local: use this worktree's WEB_PORT.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Daily Brief"
WEBAUTHN_ORIGINS=http://localhost:5173
# Non-owner invites and recovery stay off until AnthropicApiRunner is complete (DESIGN 3.1)
NON_OWNER_ADMISSION=false
# HMAC key for client-IP rate-limit buckets (generate a random value)
RATE_LIMIT_KEY=change-me-local-only

# --- Owner identity for the claude_subscription runner (DESIGN 3.1). Local seeded owner UUID from db/README.md ---
OWNER_USER_ID=00000000-0000-4000-8000-000000000001

# --- Optional: installed worker executable the API's local dispatcher runs (no shell). Empty = stub dispatcher ---
LOCAL_WORKER_COMMAND=

# --- Worker <-> API internal token ---
INTERNAL_SERVICE_TOKEN=change-me-local-only
API_BASE_URL=http://api:8000

# --- Scheduler (replaces EventBridge locally) ---
SCHEDULER_INTERVAL_SECONDS=900

# --- Shared agent memory (absolute path to ../daily-brief-memory/docs/agent-memory) ---
BRIEF_MEMORY_DIR=

# --- Production only (M2+). Leave empty locally ---
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=ShengKai234/daily-brief
